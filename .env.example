# Copy to .env for local use. Only dummy LocalStack values belong here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# Override the terraform binary (e.g. TF=tofu) if you use OpenTofu.
TF=terraform
# Set to 1 to run the Iceberg MERGE integration test (downloads the Iceberg jar).
ICEBERG_IT=0
